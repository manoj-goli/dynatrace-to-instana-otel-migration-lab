# --- Dynatrace OTLP Export ---
# Get the base URL from your Dynatrace environment (without .app)
# Format: https://<env-id>.live.dynatrace.com/api/v2/otlp
DT_ENDPOINT=https://your-env-id.live.dynatrace.com/api/v2/otlp
DT_API_TOKEN=your-dynatrace-api-token-here

# --- Instana OTLP Export ---
# Get the OTLP endpoint from Instana UI > Settings > Agents > OpenTelemetry
# gRPC format: https://otlp-<region>.instana.io:4317
# HTTP format: https://otlp-<region>.instana.io:4318
INSTANA_OTLP_ENDPOINT=https://otlp-your-region.instana.io:4318
INSTANA_AGENT_KEY=your-instana-agent-key-here

# --- GCP (informational) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_VM_ZONE=us-central1-a
